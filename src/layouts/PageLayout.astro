---
import type { ImageMetadata } from 'astro';
import PageHeader from '../components/PageHeader.astro';
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  subtitle?: string;
  headerImage: ImageMetadata;
  description?: string;
  /** Link preview image; defaults to the header image. */
  shareImage?: ImageMetadata;
}

const { title, subtitle, headerImage, description, shareImage = headerImage } = Astro.props;
---

<BaseLayout title={title} description={description} shareImage={shareImage}>
  <PageHeader title={title} subtitle={subtitle} image={headerImage} />
  <main class="container">
    <slot />
  </main>
</BaseLayout>

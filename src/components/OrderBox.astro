---
// Highlighted call-out with an email button, e.g. "Prints available" or "CDs available".
import { site } from '../site';

interface Props {
  heading: string;
  /** Subject line of the email the button opens. */
  subject: string;
  buttonLabel: string;
}

const { heading, subject, buttonLabel } = Astro.props;
const href = `mailto:${site.email}?subject=${encodeURIComponent(subject)}`;
---

<aside class="order">
  <h2>{heading}</h2>
  <p><slot /></p>
  <a class="button" href={href}>{buttonLabel}</a>
</aside>

<style>
  .order {
    padding: 1.5rem;
    border: 1px solid var(--color-accent);
    border-left-width: 4px;
    background: rgb(242 163 27 / 0.06);
  }

  h2 {
    margin: 0 0 0.5rem;
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: none;
    color: var(--color-accent);
  }

  p {
    margin: 0 0 1.25rem;
  }

  .button {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0.75em 1.5em;
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #000;
    background: var(--color-accent);
    transition: background-color 0.2s;
  }

  .button:hover,
  .button:focus-visible {
    color: #000;
    background: #fff;
  }
</style>

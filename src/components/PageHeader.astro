---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  title: string;
  subtitle?: string;
  image: ImageMetadata;
}

const { title, subtitle, image } = Astro.props;
---

<header class="page-header">
  <Image src={image} alt="" widths={[640, 1024, 1600, 2400]} sizes="100vw" loading="eager" fetchpriority="high" />
  <div class="heading">
    <h1>{title}</h1>
    <hr />
    {subtitle && <p class="subheading">{subtitle}</p>}
  </div>
</header>

<style>
  .page-header {
    position: relative;
    display: grid;
    place-items: center;
    min-height: clamp(18rem, 55vw, 32rem);
    margin-bottom: 3rem;
    padding: 6rem var(--gutter) 3rem;
    overflow: hidden;
    background-color: #808080;
    text-align: center;
    color: #fff;
  }

  .page-header img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .heading {
    position: relative;
    text-shadow: 1px 1px 4px #000;
  }

  h1 {
    margin: 0;
    font-size: clamp(2rem, 1rem + 5vw, 5rem);
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }

  hr {
    width: 100px;
    margin: 1rem auto;
    border: 0;
    border-top: 4px solid #fff;
  }

  .subheading {
    margin: 0;
    font-size: clamp(1.15rem, 1rem + 0.9vw, 1.6rem);
    font-weight: 600;
  }
</style>

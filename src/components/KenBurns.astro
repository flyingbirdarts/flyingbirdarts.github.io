---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  images: ImageMetadata[];
  /** How long each image is fully shown, in ms (the original theme used 5000). */
  displayTime?: number;
  /** Crossfade length between images, in ms. */
  fadeTime?: number;
  /** How far each image zooms over its time on screen. */
  zoom?: number;
}

const { images, displayTime = 5000, fadeTime = 1000, zoom = 1.2 } = Astro.props;
---

<div class="kenburns" data-display-time={displayTime} data-fade-time={fadeTime} data-zoom={zoom}>
  {
    images.map((src, i) => (
      <Image
        src={src}
        alt=""
        widths={[640, 1024, 1600, 2400]}
        sizes="100vw"
        loading="eager"
        fetchpriority={i === 0 ? 'high' : 'low'}
        decoding="async"
        class:list={['slide', { active: i === 0 }]}
      />
    ))
  }
  {
    images.length > 1 && (
      <button class="pause" type="button" aria-pressed="false">
        <span class="visually-hidden">Pause slideshow</span>
        <svg class="icon-pause" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path d="M7 5h3v14H7zM14 5h3v14h-3z" fill="currentColor" />
        </svg>
        <svg class="icon-play" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path d="M8 5v14l11-7z" fill="currentColor" />
        </svg>
      </button>
    )
  }
</div>

<script>
  const root = document.querySelector<HTMLElement>('.kenburns');
  const slides = root ? [...root.querySelectorAll<HTMLImageElement>('.slide')] : [];
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (root && slides.length > 1) {
    const displayTime = Number(root.dataset.displayTime);
    const fadeTime = Number(root.dataset.fadeTime);
    const zoom = Number(root.dataset.zoom);
    const pauseButton = root.querySelector<HTMLButtonElement>('.pause')!;

    let index = 0;
    let timer: number | undefined;
    let paused = false;
    const motions = new Map<HTMLImageElement, Animation>();

    // Like the original plugin: alternate zooming in and out, drifting towards a random edge.
    const move = (slide: HTMLImageElement, n: number) => {
      motions.get(slide)?.cancel();
      if (reducedMotion.matches) return;
      // Largest shift (in % of the unscaled image) that keeps the zoomed image covering the frame.
      const pan = ((zoom - 1) / (2 * zoom)) * 100 * 0.9;
      const dx = (Math.floor(Math.random() * 3) - 1) * pan;
      const dy = (Math.floor(Math.random() * 3) - 1) * pan;
      const zoomed = `scale(${zoom}) translate(${dx}%, ${dy}%)`;
      const frames = n % 2 ? [{ transform: 'scale(1)' }, { transform: zoomed }] : [{ transform: zoomed }, { transform: 'scale(1)' }];
      const animation = slide.animate(frames, {
        duration: displayTime + fadeTime * 2,
        easing: 'linear',
        fill: 'both',
      });
      if (paused) animation.pause();
      motions.set(slide, animation);
    };

    const schedule = () => {
      clearTimeout(timer);
      if (!paused && !reducedMotion.matches) timer = window.setTimeout(advance, displayTime + fadeTime);
    };

    const advance = async () => {
      const next = (index + 1) % slides.length;
      const incoming = slides[next];
      // Don't fade to an image that hasn't finished loading.
      await incoming.decode().catch(() => {});
      if (paused) return;
      move(incoming, next);
      slides[index].classList.remove('active');
      incoming.classList.add('active');
      index = next;
      schedule();
    };

    const setPaused = (value: boolean) => {
      paused = value;
      pauseButton.setAttribute('aria-pressed', String(value));
      pauseButton.querySelector('.visually-hidden')!.textContent = value ? 'Play slideshow' : 'Pause slideshow';
      motions.forEach((animation) => {
        if (value && animation.playState === 'running') animation.pause();
        else if (!value && animation.playState === 'paused') animation.play();
      });
      schedule();
    };

    pauseButton.addEventListener('click', () => setPaused(!paused));
    reducedMotion.addEventListener('change', () => {
      move(slides[index], index);
      schedule();
    });

    // Timers are throttled in background tabs; restart cleanly when the page is visible again.
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) clearTimeout(timer);
      else schedule();
    });

    root.style.setProperty('--fade-time', `${fadeTime}ms`);
    move(slides[0], 0);
    schedule();
  }
</script>

<style>
  .kenburns {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: #000;
  }

  .slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity var(--fade-time, 1s) ease-in-out;
    will-change: transform, opacity;
  }

  .slide.active {
    opacity: 1;
  }

  .pause {
    position: absolute;
    right: var(--gutter);
    bottom: var(--gutter);
    z-index: 2;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    color: #fff;
    background: rgb(0 0 0 / 0.35);
    border: 1px solid rgb(255 255 255 / 0.5);
    border-radius: 50%;
    cursor: pointer;
    opacity: 0.7;
    transition:
      opacity 0.2s,
      background-color 0.2s;
  }

  .pause:hover,
  .pause:focus-visible {
    opacity: 1;
    background: rgb(0 0 0 / 0.6);
  }

  .pause:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .pause .icon-play,
  .pause[aria-pressed='true'] .icon-pause {
    display: none;
  }

  .pause[aria-pressed='true'] .icon-play {
    display: block;
  }

  @media (prefers-reduced-motion: reduce) {
    .pause {
      display: none;
    }
  }
</style>

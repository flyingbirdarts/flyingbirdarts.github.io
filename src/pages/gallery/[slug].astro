---
import { getImage } from 'astro:assets';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import PaintingFigure, { type Painting } from '../../components/PaintingFigure.astro';
import OrderBox from '../../components/OrderBox.astro';
import PaintingLightbox from '../../components/PaintingLightbox.astro';
import PageLayout from '../../layouts/PageLayout.astro';

export async function getStaticPaths() {
  const collections = await getCollection('art');
  return collections.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'art'>;
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const hasWriteUp = Boolean(entry.body?.trim());

// Paintings are kept at low resolution (600px max) on purpose, to discourage reproductions.
// Link to a WebP at that native size rather than the original JPEG.
const slugify = (text: string) =>
  text
    .toLowerCase()
    .normalize('NFKD')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');
const usedIds = new Map<string, number>();
const paintings: Painting[] = await Promise.all(
  data.paintings.map(async (p) => {
    // Unique per collection (two paintings can share a title), used for links like #makalu.
    const base = slugify(p.title) || 'painting';
    const count = (usedIds.get(base) ?? 0) + 1;
    usedIds.set(base, count);
    return {
      image: p.image,
      title: p.title,
      pid: count > 1 ? `${base}-${count}` : base,
      full: (await getImage({ src: p.image, format: 'webp' })).src,
      details: [p.material, p.dimensions].filter(Boolean).join(', '),
      link: p.link,
    };
  }),
);

// A featured work is shown large beside its story, with the remaining images as close-ups.
const work = data.featured ? paintings[0] : undefined;
const closeUps = work ? paintings.slice(1) : paintings;
const gridSizes = '(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw';
---

<PageLayout title={data.title} headerImage={data.header}>
  <div data-lightbox>
    {
      work ? (
        <section class="feature">
          <div class="work">
            <PaintingFigure painting={work} sizes="(min-width: 900px) 600px, 100vw" eager />
          </div>
          <div class="story">
            <div class="prose">
              <Content />
            </div>
            <div class="prints">
              <OrderBox heading="Prints available" subject={`Prints of "${data.title}"`} buttonLabel="Email about prints">
                Prints of <i>{data.title}</i> are available. Get in touch for sizes and pricing.
              </OrderBox>
            </div>
          </div>
        </section>
      ) : (
        hasWriteUp && (
          <div class="prose intro">
            <Content />
          </div>
        )
      )
    }

    {work && <h2 class="section-heading">Details</h2>}
    <ul class="paintings">
      {
        closeUps.map((p) => (
          <li>
            <PaintingFigure painting={p} sizes={gridSizes} compact={Boolean(work)} />
          </li>
        ))
      }
    </ul>
  </div>
  <PaintingLightbox />
</PageLayout>

<style>
  .paintings {
    columns: 1;
    column-gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 640px) {
    .paintings {
      columns: 2;
    }
  }

  @media (min-width: 1024px) {
    .paintings {
      columns: 3;
    }
  }

  li {
    break-inside: avoid;
    margin-bottom: 1.5rem;
  }

  .prose {
    max-width: 40rem;
    line-height: 1.7;
  }

  .prose :global(p) {
    margin: 0 0 1.25em;
  }

  .intro {
    margin: 0 auto 2.5rem;
  }

  /* Featured work: painting beside its story on wide screens, stacked on phones. */
  .feature {
    display: grid;
    gap: 2rem 3rem;
    margin-bottom: 3.5rem;
  }

  .work {
    /* Never stretch the painting past 1.5× its native size. */
    max-width: 600px;
  }

  @media (min-width: 900px) {
    .feature {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: start;
    }

    /* Keep the painting in view while reading the story beside it. */
    .work {
      position: sticky;
      top: 2rem;
    }
  }

  .prints {
    margin-top: 1rem;
  }

  .section-heading {
    margin: 0 0 1.5rem;
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
</style>

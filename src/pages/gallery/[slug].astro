---
import { Image } from 'astro:assets';
import { getCollection, type CollectionEntry } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';

export async function getStaticPaths() {
  const collections = await getCollection('art');
  return collections.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'art'>;
}

const { data } = Astro.props.entry;
---

<PageLayout title={data.title} headerImage={data.header}>
  <!-- TODO: masonry hover captions + lightbox. -->
  <ul class="paintings">
    {
      data.paintings.map((p) => (
        <li>
          <figure>
            <a href={p.image.src}>
              <Image src={p.image} alt={p.title} widths={[400, 800, 1200]} sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw" />
            </a>
            <figcaption>
              <strong>{p.title}</strong>
              {p.material && <span>{p.material}</span>}
              {p.dimensions && <span>{p.dimensions}</span>}
            </figcaption>
          </figure>
        </li>
      ))
    }
  </ul>
</PageLayout>

<style>
  .paintings {
    columns: 1;
    column-gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 640px) {
    .paintings {
      columns: 2;
    }
  }

  @media (min-width: 1024px) {
    .paintings {
      columns: 3;
    }
  }

  li {
    break-inside: avoid;
    margin-bottom: 1.5rem;
  }

  figure {
    margin: 0;
  }

  figcaption {
    display: flex;
    flex-direction: column;
    padding-top: 0.5rem;
    font-size: 0.9rem;
  }

  figcaption span {
    font-family: Times, serif;
    font-style: italic;
    color: var(--color-muted);
  }
</style>

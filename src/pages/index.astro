---
import KenBurns from '../components/KenBurns.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../site';
import bg1 from '../assets/home/bg1.jpg';
import bg2 from '../assets/home/bg2.jpg';
import bg3 from '../assets/home/bg3.jpg';
import bg4 from '../assets/home/bg4.jpg';
import bg5 from '../assets/home/bg5.jpg';
import paulFlute from '../assets/home/paulflute_colorado.jpg';

// Same images and order as the Jekyll home page slideshow.
const slides = [bg5, bg1, bg4, bg2, bg3, paulFlute];
---

<BaseLayout bare>
  <main class="hero">
    <KenBurns images={slides} />
    <div class="intro">
      <h1>{site.title}</h1>
      <p class="subtitle">{site.subtitle}</p>
      <div class="cta">
        <a class="button" href="/gallery/">View the Gallery</a>
        <a class="button" href="/music/">Listen to the Music</a>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .hero {
    position: relative;
    height: 100dvh;
    overflow: hidden;
  }

  /* Darken the centre of the artwork so the title and buttons stay legible. */
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center, rgb(0 0 0 / 0.55), rgb(0 0 0 / 0.15) 70%);
    pointer-events: none;
  }

  .intro {
    position: absolute;
    z-index: 1;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    /* Top padding clears the nav so the block is centred in the space below it. */
    padding: 5rem var(--gutter) 2rem;
    text-align: center;
    font-family: var(--font-display);
    color: #ddd;
    text-shadow: 0.1em 0.1em 0.2em #000;
  }

  h1 {
    margin: 0 0 0.25em;
    font-size: clamp(2rem, 1rem + 5vw, 4.5rem);
    font-weight: 600;
    letter-spacing: 0.1em;
  }

  .subtitle {
    margin: 0 0 1.25em;
    font-size: clamp(1.1rem, 1rem + 1vw, 1.75rem);
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem 1rem;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0.75em 1.75em;
    font-size: clamp(0.95rem, 0.9rem + 0.25vw, 1.1rem);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-shadow: none;
    color: #fff;
    background: rgb(0 0 0 / 0.45);
    border: 2px solid #fff;
    backdrop-filter: blur(4px);
    transition:
      background-color 0.25s,
      color 0.25s;
  }

  .button:hover,
  .button:focus-visible {
    color: #000;
    background: #fff;
  }

  .button:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  @media (max-width: 479px) {
    .cta {
      flex-direction: column;
      align-self: stretch;
    }
  }
</style>

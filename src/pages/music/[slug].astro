---
import { Image } from 'astro:assets';
import { getCollection, type CollectionEntry } from 'astro:content';
import AudioPlaylist from '../../components/AudioPlaylist.astro';
import OrderBox from '../../components/OrderBox.astro';
import PageLayout from '../../layouts/PageLayout.astro';

export async function getStaticPaths() {
  const albums = await getCollection('albums');
  return albums.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'albums'>;
}

const { id, data } = Astro.props.entry;
const tracks = data.tracks.map((t) => ({ ...t, src: `/music/${id}/tracks/${t.file}` }));
---

<PageLayout title={data.title} subtitle={data.label} headerImage={data.header} shareImage={data.cover}>
  <div class="album">
    <div class="cover">
      <Image
        src={data.cover}
        alt={`${data.title} album cover`}
        widths={[300, 600]}
        sizes="(min-width: 900px) 24rem, 100vw"
        loading="eager"
      />
    </div>

    <div class="listen">
      {
        data.cdAvailable && (
          <div class="cd">
            <OrderBox heading="CDs available" subject={`CD order: ${data.title}`} buttonLabel="Email to order">
              <i>{data.title}</i> is available on CD. Email to order a copy.
            </OrderBox>
          </div>
        )
      }

      <h2>Preview tracks</h2>
      <AudioPlaylist album={data.title} tracks={tracks} cover={data.cover} />

      {
        data.spotifyAlbumId && (
          <section class="spotify">
            <h3>Listen to the full album on Spotify</h3>
            <iframe
              title={`${data.title} on Spotify`}
              src={`https://open.spotify.com/embed/album/${data.spotifyAlbumId}`}
              width="100%"
              height="380"
              loading="lazy"
              allow="encrypted-media"
            />
          </section>
        )
      }
    </div>
  </div>
</PageLayout>

<style>
  .album {
    display: grid;
    gap: 2rem 3rem;
  }

  .cover {
    max-width: 24rem;
  }

  .cover img {
    width: 100%;
    box-shadow: 0 10px 40px rgb(0 0 0 / 0.8);
  }

  h2 {
    margin: 0 0 1rem;
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .cd {
    margin-bottom: 2.5rem;
  }

  .spotify {
    margin-top: 2.5rem;
  }

  .spotify h3 {
    margin: 0 0 1rem;
    font-size: 1.1rem;
  }

  iframe {
    border: 0;
    border-radius: 12px;
  }

  @media (min-width: 900px) {
    .album {
      grid-template-columns: 24rem minmax(0, 1fr);
      align-items: start;
    }

    .cover {
      position: sticky;
      top: 2rem;
    }
  }
</style>

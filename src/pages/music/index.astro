---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import header from '../../assets/headers/music-bg.jpg';

const albums = (await getCollection('albums')).sort((a, b) => a.data.order - b.data.order);
---

<PageLayout title="Music" subtitle="Indian Classical Music" headerImage={header}>
  <ul class="albums">
    {
      albums.map(({ id, data }) => (
        <li>
          <a href={`/music/${id}/`}>
            <Image src={data.cover} alt={`${data.title} album cover`} widths={[400, 800]} sizes="(min-width: 768px) 33vw, 100vw" />
            <span class="name">{data.title}</span>
            <span class="year">{data.year}</span>
          </a>
        </li>
      ))
    }
  </ul>
</PageLayout>

<style>
  .albums {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .albums a {
    display: block;
    color: var(--color-text);
  }

  .name {
    display: block;
    padding-top: 0.5rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  .year {
    color: var(--color-muted);
  }
</style>
